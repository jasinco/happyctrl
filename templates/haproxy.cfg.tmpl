# Generated by happyctrl — edit the template, not this file.
# Rendered from: {{.TemplatePath}}
#
# All HAProxy settings live in this template; edit them freely.
# happyctrl only fills in the parts from .ACLs and .Services
# (the acl and use_backend lines in "frontend https" and the be_<name> backends).

global
        log /dev/log    local0
        log /dev/log    local1 notice
        # chroot /var/lib/haproxy
        stats socket /run/haproxy/admin.sock mode 660 level admin
        stats timeout 30s
        user haproxy
        group haproxy
        daemon

        # Default SSL material locations
        ca-base /etc/ssl/certs
        crt-base /etc/ssl/haproxy

        # See: https://ssl-config.mozilla.org/#server=haproxy&server-version=2.0.3&config=intermediate
        ssl-default-bind-ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384
        ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
        ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets

defaults
        log     global
        mode    http

        option  httplog
        option  dontlognull
        option  http-keep-alive

        timeout connect 5s
        timeout client  180s
        timeout server  30s
        timeout tunnel 1h

        errorfile 400 /etc/haproxy/errors/400.http
        errorfile 403 /etc/haproxy/errors/403.http
        errorfile 408 /etc/haproxy/errors/408.http
        errorfile 500 /etc/haproxy/errors/500.http
        errorfile 502 /etc/haproxy/errors/502.http
        errorfile 503 /etc/haproxy/errors/503.http
        errorfile 504 /etc/haproxy/errors/504.http

# Plain HTTP: permanently redirect everything to HTTPS (same host, path, query).
frontend http
        bind :80
        mode http
        http-request redirect scheme https code 301

frontend https
        # bind quic4@:443 ssl crt snakeoil.pem  alpn h3
        # bind :443 ssl crt snakeoil.pem alpn h2,http/1.1
        mode http

        # http-after-response add-header alt-svc 'h3=":443"; ma=60'

        # HSTS: browsers use HTTPS only for this host for 2 years. set-header
        # replaces any HSTS header a backend sends, so there is one policy.
        # Add "; includeSubDomains" only if every subdomain serves HTTPS.
        http-after-response set-header Strict-Transport-Security "max-age=63072000"

        option forwardfor
        http-request set-header Host %[hdr(host)]
        http-request set-header X-Forwarded-Proto https
        http-request set-header True-Client-IP %[src]
        http-request set-header X-Real-IP %[src]

        # --- happyctrl: routing by hostname ---
        # Host without port, lowercased, for exact matching below.
        http-request set-var(txn.host) req.hdr(host),field(1,:),lower

        # Named acls (happyctrl acl add). Repeated names are OR'ed by haproxy.
{{- range $acl := .ACLs}}
{{- range $acl.Rules}}
        acl {{$acl.Name}} {{.}}
{{- end}}
{{- end}}

        # A service's acls are appended to its host match: all must be true.
{{- range .Services}}
        use_backend be_{{.Name}} if { var(txn.host) -m str {{join .Hosts " "}} }{{range .ACLs}} {{.}}{{end}}
{{- end}}
        # Unknown hosts (or failed acls) get a 404. To send them to a service
        # instead, use e.g. "default_backend be_jellyfin".
        default_backend be_notfound

backend be_notfound
        http-request deny deny_status 404
{{range $svc := .Services}}
backend be_{{$svc.Name}}
{{- if $svc.Balance}}
        balance {{$svc.Balance}}
{{- end}}
{{- if $svc.HealthCheck}}
        option httpchk
        http-check send meth GET uri {{$svc.HealthCheck}}
{{- end}}
{{- range $svc.Extra}}
        {{.}}
{{- end}}
{{- range $svc.Servers}}
        # "check" on every server: TCP connect check, or HTTP check when the
        # service has a health check path.
        server {{.Name}} {{.Addr}} check{{if $svc.ServerSSL}} ssl verify none{{end}}{{if .Options}} {{.Options}}{{end}}
{{- end}}
{{end -}}
